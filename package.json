{
  "name": "serviceflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "argon2": "^0.45.1",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.20.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prisma/client": "6.16.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prisma": "6.16.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
