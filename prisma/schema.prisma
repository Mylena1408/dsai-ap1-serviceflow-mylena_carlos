generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REQUESTER
  ATTENDANT
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentFormat {
  PDF
  DOCX
  TXT
}

enum ServiceFieldType {
  SHORT_TEXT
  LONG_TEXT
  INTEGER
  DATE
  SELECT
  YES_NO
}

model Sector {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  users    User[]
  services Service[]
  requests Request[]
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  services Service[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique @db.Citext
  role         Role
  sectorId     String?  @db.Uuid
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  sector                Sector?                  @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  requests              Request[]                @relation("UserRequests")
  requestStatusEvents   RequestStatusEvent[]     @relation("RequestStatusEventActor")
  uploadedAttachments   RequestAttachment[]      @relation("RequestAttachmentUploader")
  assignedRequests      Request[]                @relation("RequestAssignee")
  assignmentEventsActed RequestAssignmentEvent[] @relation("RequestAssignmentEventActor")
  assignmentEventsFrom  RequestAssignmentEvent[] @relation("RequestAssignmentEventFrom")
  assignmentEventsTo    RequestAssignmentEvent[] @relation("RequestAssignmentEventTo")
  comments              RequestComment[]         @relation("RequestCommentAuthor")
  notifications         RequestNotification[]    @relation("NotificationRecipient")
  priorityEvents        RequestPriorityEvent[]   @relation("RequestPriorityEventActor")
  stageEvents           RequestStageEvent[]      @relation("RequestStageEventActor")
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  description     String
  categoryId      String          @db.Uuid
  sectorId        String          @db.Uuid
  isActive        Boolean         @default(true)
  defaultPriority RequestPriority @default(NORMAL)
  slaHours        Int?
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  category             Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sector               Sector                       @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  requests             Request[]
  documentRequirements ServiceDocumentRequirement[]
  fields               ServiceField[]
  stages               ServiceStage[]
}

model Request {
  id                         String          @id @default(uuid()) @db.Uuid
  requesterId                String          @db.Uuid
  serviceId                  String          @db.Uuid
  sectorId                   String          @db.Uuid
  serviceNameSnapshot        String
  serviceDescriptionSnapshot String
  categoryIdSnapshot         String          @db.Uuid
  categoryNameSnapshot       String
  sectorNameSnapshot         String
  description                String
  status                     RequestStatus   @default(OPEN)
  createdAt                  DateTime        @default(now()) @db.Timestamptz
  updatedAt                  DateTime        @updatedAt @db.Timestamptz
  completedAt                DateTime?       @db.Timestamptz
  assigneeId                 String?         @db.Uuid
  cancelledAt                DateTime?       @db.Timestamptz
  priority                   RequestPriority @default(NORMAL)
  slaHoursSnapshot           Int?
  dueAt                      DateTime?       @db.Timestamptz
  /// Start of "próximo do vencimento"; filled by a database trigger, never written by the app.
  dueSoonAt                  DateTime?       @db.Timestamptz
  slaWarningNotifiedAt       DateTime?       @db.Timestamptz
  slaBreachNotifiedAt        DateTime?       @db.Timestamptz
  completedLate              Boolean?
  /// Stage names copied when the attendance starts (SPEC de fluxos, 5.2); empty without a flow.
  stageNamesSnapshot         String[]        @default([])
  /// Current position in stageNamesSnapshot; null exactly when the copy is empty.
  stageIndex                 Int?

  requester        User                     @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee         User?                    @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sector           Sector                   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  events           RequestStatusEvent[]
  attachments      RequestAttachment[]
  assignmentEvents RequestAssignmentEvent[]
  priorityEvents   RequestPriorityEvent[]
  fieldValues      RequestFieldValue[]
  stageEvents      RequestStageEvent[]
  comments         RequestComment[]
  outboxEvents     OutboxEvent[]
  notifications    RequestNotification[]

  @@index([requesterId])
  @@index([sectorId])
  @@index([sectorId, assigneeId])
  @@index([requesterId, createdAt, id])
  @@index([sectorId, createdAt, id])
  @@index([sectorId, dueAt])
  @@index([sectorId, dueSoonAt])
}

model RequestStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @db.Uuid
  actorId    String         @db.Uuid
  fromStatus RequestStatus?
  toStatus   RequestStatus
  occurredAt DateTime       @default(now()) @db.Timestamptz
  note       String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestStatusEventActor", fields: [actorId], references: [id], onDelete: Restrict)
}

model RequestAssignmentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @db.Uuid
  actorId        String   @db.Uuid
  fromAssigneeId String?  @db.Uuid
  toAssigneeId   String?  @db.Uuid
  occurredAt     DateTime @default(now()) @db.Timestamptz

  request      Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor        User    @relation("RequestAssignmentEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromAssignee User?   @relation("RequestAssignmentEventFrom", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee   User?   @relation("RequestAssignmentEventTo", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

// Name uniqueness among active requirements of a service and row-level CHECK
// constraints are created in SQL by migration 20261016120000_document_requirements_and_attachments.
model ServiceDocumentRequirement {
  id              String           @id @default(uuid()) @db.Uuid
  serviceId       String           @db.Uuid
  name            String           @db.Citext
  isRequired      Boolean
  acceptedFormats DocumentFormat[]
  position        Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  attachments RequestAttachment[]

  @@index([serviceId])
}

// Attachments are immutable metadata; file content lives in private object storage.
model RequestAttachment {
  id                          String         @id @default(uuid()) @db.Uuid
  requestId                   String         @db.Uuid
  requirementId               String         @db.Uuid
  requirementNameSnapshot     String
  requirementRequiredSnapshot Boolean
  originalFilename            String
  detectedFormat              DocumentFormat
  contentType                 String
  sizeBytes                   Int
  sha256                      String         @db.Char(64)
  storageKey                  String
  uploadedById                String         @db.Uuid
  createdAt                   DateTime       @default(now()) @db.Timestamptz

  request     Request                    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requirement ServiceDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  uploadedBy  User                       @relation("RequestAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([requestId, requirementId])
  @@index([requirementId])
  @@index([uploadedById])
}

model RequestComment {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User    @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  requestId     String    @db.Uuid
  payload       Json
  occurredAt    DateTime  @db.Timestamptz
  availableAt   DateTime  @db.Timestamptz
  attempts      Int       @default(0)
  processedAt   DateTime? @db.Timestamptz
  failedAt      DateTime? @db.Timestamptz
  lastErrorCode String?

  request       Request               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  notifications RequestNotification[]

  @@index([processedAt, failedAt, availableAt])
}

model RequestNotification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  requestId   String    @db.Uuid
  eventId     String?   @db.Uuid
  type        String
  createdAt   DateTime  @db.Timestamptz
  readAt      DateTime? @db.Timestamptz

  recipient User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  request   Request      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event     OutboxEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([eventId, recipientId])
  @@index([recipientId, readAt, createdAt])
}

model RequestPriorityEvent {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @db.Uuid
  actorId      String          @db.Uuid
  fromPriority RequestPriority
  toPriority   RequestPriority
  occurredAt   DateTime        @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestPriorityEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// Custom field of a service (SPEC 2026-11-01-campos-personalizados, section 6).
model ServiceField {
  id         String           @id @default(uuid()) @db.Uuid
  serviceId  String           @db.Uuid
  label      String           @db.Citext
  helpText   String?
  type       ServiceFieldType
  isRequired Boolean
  options    String[]
  minValue   Int?
  maxValue   Int?
  position   Int
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now()) @db.Timestamptz
  updatedAt  DateTime         @updatedAt @db.Timestamptz

  service Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  values  RequestFieldValue[]

  @@index([serviceId])
}

/// Answer given on opening, with a snapshot of the field definition; immutable.
model RequestFieldValue {
  id               String           @id @default(uuid()) @db.Uuid
  requestId        String           @db.Uuid
  fieldId          String           @db.Uuid
  labelSnapshot    String
  typeSnapshot     ServiceFieldType
  positionSnapshot Int
  value            String
  createdAt        DateTime         @default(now()) @db.Timestamptz

  request Request      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  field   ServiceField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([requestId, fieldId])
  @@index([fieldId])
}

/// Stage of a service's attendance flow (SPEC 2026-11-01-fluxos-configuraveis, section 6).
model ServiceStage {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  name      String   @db.Citext
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId])
}

/// Entry into a stage of the request's flow copy; fromStage is null on the first stage.
model RequestStageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  actorId    String   @db.Uuid
  fromStage  String?
  toStage    String
  note       String?
  occurredAt DateTime @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestStageEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}
