generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REQUESTER
  ATTENDANT
  MANAGER
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum Permission {
  SECTOR_SERVICES
  SECTOR_REQUESTS_READ
  QUEUE_SUPERVISION
}

enum PermissionAction {
  GRANTED
  REVOKED
}

enum NotificationCategory {
  STATUS
  ASSIGNMENT
  COMMENTS
  SLA
  STAGES
  APPROVALS
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Audit trail (SPEC 2026-11-02-auditoria-lgpd, 5.1).
enum AuditAction {
  CREATED
  UPDATED
  REORDERED
  DEACTIVATED
  REACTIVATED
  ANONYMIZED
  EXPORTED
  REVOKED
  SECRET_ROTATED
  DELETED
  /// SPEC 2026-11-07-operacao-e-automacao, 6.4 (decision H15): the configuration's import and export.
  IMPORTED
  EXPORTED_CONFIGURATION
}

enum AuditEntityType {
  USER
  SECTOR
  CATEGORY
  SERVICE
  DOCUMENT_REQUIREMENT
  SERVICE_FIELD
  SERVICE_STAGE
  API_TOKEN
  WEBHOOK
  BUSINESS_CALENDAR
  HOLIDAY
  KNOWLEDGE_ARTICLE
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 6.3.3.
  ACCESS_ROLE
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 7.4.
  ESCALATION_RULE
  /// SPEC 2026-11-07-operacao-e-automacao, 3.4.
  SERVICE_BUNDLE
  /// 5.4.
  RECURRING_REQUEST
  /// 6.4.
  CONFIGURATION
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 3.4.
  SECTOR_TAG
  /// 4.4.
  CHECKLIST_ITEM
}

/// SPEC 2026-11-02-api-externa-webhooks, 5.2 (decision A2).
enum ApiTokenScope {
  READ
  WRITE
}

/// SPEC 2026-11-02-api-externa-webhooks, 5.6.
enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentFormat {
  PDF
  DOCX
  TXT
}

enum ServiceFieldType {
  SHORT_TEXT
  LONG_TEXT
  INTEGER
  DATE
  SELECT
  YES_NO
  /// SPEC 2026-11-03-campos-condicionais-atendimento, 5.1.
  MULTI_SELECT
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 3.3.
  DECIMAL
  EMAIL
  PHONE
  CPF
  CNPJ
  CEP
}

/// Who fills a custom field (SPEC 2026-11-03-campos-condicionais-atendimento, 5.4).
enum ServiceFieldAudience {
  REQUESTER
  ATTENDANT
}

model Sector {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.Citext
  isActive        Boolean  @default(true)
  /// SPEC 2026-11-06-escalonamento, 2.1: overdue requests raise their priority and warn the managers.
  escalateOverdue Boolean  @default(false)
  /// SPEC 2026-11-07-operacao-e-automacao, 4.3 (decision H6): how requests entering the queue are assigned.
  distributionMode      DistributionMode @default(NONE)
  /// 1 to 100 active requests per attendant, or no limit.
  maxActivePerAttendant Int?
  /// 4.3 item 7: hand an absent attendant's requests to colleagues when the absence starts.
  redistributeOnAbsence Boolean          @default(false)
  /// Last attendant who received by distribution (the round-robin's turn).
  lastDistributedToId   String?          @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  users            User[]
  services         Service[]
  requests         Request[]
  requestsSentAway RequestSectorEvent[] @relation("RequestSectorEventFrom")
  requestsReceived RequestSectorEvent[] @relation("RequestSectorEventTo")
  cannedResponses  CannedResponse[]
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.4: requests whose pending level is this sector.
  pendingApprovals Request[]            @relation("RequestApprovalPendingSector")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 7.
  escalationRules  SectorEscalationRule[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 3.4.
  tags             SectorTag[]
  lastDistributedTo User?                @relation("SectorLastDistributedTo", fields: [lastDistributedToId], references: [id], onDelete: SetNull)
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  services Service[]
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique @db.Citext
  role         Role
  sectorId     String?   @db.Uuid
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  /// SPEC 2026-11-02-auditoria-lgpd, 5.5: set once, when the person is anonymized.
  anonymizedAt DateTime? @db.Timestamptz

  sector                 Sector?                    @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  requests               Request[]                  @relation("UserRequests")
  requestStatusEvents    RequestStatusEvent[]       @relation("RequestStatusEventActor")
  uploadedAttachments    RequestAttachment[]        @relation("RequestAttachmentUploader")
  assignedRequests       Request[]                  @relation("RequestAssignee")
  assignmentEventsActed  RequestAssignmentEvent[]   @relation("RequestAssignmentEventActor")
  assignmentEventsFrom   RequestAssignmentEvent[]   @relation("RequestAssignmentEventFrom")
  assignmentEventsTo     RequestAssignmentEvent[]   @relation("RequestAssignmentEventTo")
  comments               RequestComment[]           @relation("RequestCommentAuthor")
  notifications          RequestNotification[]      @relation("NotificationRecipient")
  priorityEvents         RequestPriorityEvent[]     @relation("RequestPriorityEventActor")
  stageEvents            RequestStageEvent[]        @relation("RequestStageEventActor")
  sectorEvents           RequestSectorEvent[]       @relation("RequestSectorEventActor")
  commentFiles           RequestCommentFile[]       @relation("RequestCommentFileUploader")
  approvalsDecided       RequestApproval[]          @relation("RequestApprovalDecider")
  permissions            UserPermission[]           @relation("UserPermissionHolder")
  permissionsGranted     UserPermission[]           @relation("UserPermissionGrantor")
  permissionEvents       UserPermissionEvent[]      @relation("UserPermissionEventUser")
  permissionEventsActed  UserPermissionEvent[]      @relation("UserPermissionEventActor")
  notificationPrefs      NotificationPreference[]
  emailDeliveries        EmailDelivery[]
  apiTokens              ApiToken[]                 @relation("ApiTokenOwner")
  apiTokensRevoked       ApiToken[]                 @relation("ApiTokenRevoker")
  slaPauses              RequestSlaPause[]          @relation("RequestSlaPauseActor")
  slaResumes             RequestSlaPause[]          @relation("RequestSlaResumeActor")
  holidaysCreated        BusinessHoliday[]          @relation("BusinessHolidayCreator")
  calendarUpdates        BusinessCalendar[]         @relation("BusinessCalendarUpdater")
  fieldValuesUpdated     RequestFieldValue[]        @relation("RequestFieldValueUpdater")
  fieldUpdateEvents      RequestFieldUpdateEvent[]  @relation("RequestFieldUpdateEventActor")
  satisfactionRatings    RequestSatisfaction[]      @relation("RequestSatisfactionRequester")
  satisfactionEvents     RequestSatisfactionEvent[] @relation("RequestSatisfactionEventActor")
  cannedResponsesCreated CannedResponse[]           @relation("CannedResponseCreator")
  cannedResponsesUpdated CannedResponse[]           @relation("CannedResponseUpdater")
  knowledgeCreated       KnowledgeArticle[]         @relation("KnowledgeArticleCreator")
  knowledgeUpdated       KnowledgeArticle[]         @relation("KnowledgeArticleUpdater")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3.5.
  absences               ManagerAbsence[]           @relation("ManagerAbsenceManager")
  substitutions          ManagerAbsence[]           @relation("ManagerAbsenceSubstitute")
  absencesCreated        ManagerAbsence[]           @relation("ManagerAbsenceCreator")
  approvalsOnBehalf      RequestApproval[]          @relation("RequestApprovalOnBehalfOf")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 5.3.1.
  stagesAssigned         ServiceStage[]             @relation("ServiceStageAssignee")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 6.3.
  accessRoles            UserAccessRole[]           @relation("UserAccessRoleHolder")
  accessRolesAssigned    UserAccessRole[]           @relation("UserAccessRoleAssigner")
  accessRoleEvents       UserAccessRoleEvent[]      @relation("UserAccessRoleEventUser")
  accessRoleEventsActed  UserAccessRoleEvent[]      @relation("UserAccessRoleEventActor")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 7.
  escalationRulesAssigned SectorEscalationRule[]    @relation("SectorEscalationRuleAssignee")
  escalationsAssigned     RequestEscalation[]       @relation("RequestEscalationAssignee")
  /// SPEC 2026-11-07-operacao-e-automacao, 3.3 item 1.
  requestLinksCreated     RequestLink[]             @relation("RequestLinkCreator")
  requestLinkEvents       RequestLinkEvent[]        @relation("RequestLinkEventActor")
  /// SPEC 2026-11-07-operacao-e-automacao, 3.3 item 3.
  requestGroups           RequestGroup[]
  /// SPEC 2026-11-07-operacao-e-automacao, 4.
  sectorsLastDistributed  Sector[]                  @relation("SectorLastDistributedTo")
  attendantAbsences       AttendantAbsence[]        @relation("AttendantAbsenceUser")
  attendantAbsencesCreated AttendantAbsence[]       @relation("AttendantAbsenceCreator")
  /// SPEC 2026-11-07-operacao-e-automacao, 5.
  recurringRequestsFor    RecurringRequest[]        @relation("RecurringRequestRequester")
  recurringRequestsCreated RecurringRequest[]       @relation("RecurringRequestCreator")
  /// SPEC 2026-11-07-operacao-e-automacao, 7.4.
  savedViews               SavedView[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 3.4.
  tagsAdded                RequestTag[]
  tagEvents                RequestTagEvent[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 4.4.
  checklistItemsDone       RequestChecklistItem[]
  checklistEvents          RequestChecklistEvent[]
}

model Service {
  id                       String          @id @default(uuid()) @db.Uuid
  name                     String
  description              String
  categoryId               String          @db.Uuid
  sectorId                 String          @db.Uuid
  isActive                 Boolean         @default(true)
  defaultPriority          RequestPriority @default(NORMAL)
  slaHours                 Int?
  /// SPEC 2026-11-01-aprovacoes, 5.2: a manager of the sector approves before the attendance.
  requiresApproval         Boolean         @default(false)
  /// SPEC 2026-11-03-pausa-sla-calendario, 5.2: count the SLA only in business hours.
  slaBusinessHours         Boolean         @default(false)
  createdAt                DateTime        @default(now()) @db.Timestamptz
  updatedAt                DateTime        @updatedAt @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3 and 4.4: sectors of the approval levels,
  /// in order (empty = one level, the service's sector), and the condition that requires approval.
  approvalSectorIds        String[]        @default([]) @db.Uuid
  approvalConditionFieldId String?         @db.Uuid
  approvalConditionValue   String?
  /// 4.3.6: days to decide each level (1 to 30), or null without a deadline.
  approvalDeadlineDays     Int?

  category               Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sector                 Sector                       @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  approvalConditionField ServiceField?                @relation("ServiceApprovalCondition", fields: [approvalConditionFieldId], references: [id], onDelete: Restrict)
  requests               Request[]
  documentRequirements   ServiceDocumentRequirement[]
  /// SPEC 2026-11-07-operacao-e-automacao, 5.
  recurringRequests      RecurringRequest[]
  fields                 ServiceField[]
  stages                 ServiceStage[]
  knowledgeArticles      KnowledgeArticle[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 4.4.
  checklistItems ServiceChecklistItem[]
}

model Request {
  id                           String          @id @default(uuid()) @db.Uuid
  requesterId                  String          @db.Uuid
  serviceId                    String          @db.Uuid
  sectorId                     String          @db.Uuid
  serviceNameSnapshot          String
  serviceDescriptionSnapshot   String
  categoryIdSnapshot           String          @db.Uuid
  categoryNameSnapshot         String
  sectorNameSnapshot           String
  description                  String
  status                       RequestStatus   @default(OPEN)
  createdAt                    DateTime        @default(now()) @db.Timestamptz
  updatedAt                    DateTime        @updatedAt @db.Timestamptz
  completedAt                  DateTime?       @db.Timestamptz
  assigneeId                   String?         @db.Uuid
  cancelledAt                  DateTime?       @db.Timestamptz
  priority                     RequestPriority @default(NORMAL)
  slaHoursSnapshot             Int?
  dueAt                        DateTime?       @db.Timestamptz
  /// Start of "próximo do vencimento". A database trigger fills it in calendar hours; in business
  /// hours the application writes it (SPEC 2026-11-03-pausa-sla-calendario, 6).
  dueSoonAt                    DateTime?       @db.Timestamptz
  slaWarningNotifiedAt         DateTime?       @db.Timestamptz
  slaBreachNotifiedAt          DateTime?       @db.Timestamptz
  completedLate                Boolean?
  /// Stage names copied when the attendance starts (SPEC de fluxos, 5.2); empty without a flow.
  stageNamesSnapshot           String[]        @default([])
  /// Current position in stageNamesSnapshot; null exactly when the copy is empty.
  stageIndex                   Int?
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 5.4: per stage of the copy, the attendant
  /// ("" for none) and the target days (0 for none); empty for copies taken before.
  stageAssigneeIdsSnapshot     String[]        @default([])
  stageTargetDaysSnapshot      Int[]           @default([])
  /// Due date of the current stage and when its delay was announced (5.3.2).
  stageDueAt                   DateTime?       @db.Timestamptz
  stageOverdueNotifiedAt       DateTime?       @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 5.3.4: name of the current stage, computed by
  /// PostgreSQL from the copy and the index (a generated column). Read only: no code writes it.
  currentStageName             String?
  /// Approval situation (SPEC 2026-11-01-aprovacoes, 5.3); null when the service did not require it.
  approvalState                ApprovalState?
  /// Copy of Service.slaBusinessHours at the opening (SPEC 2026-11-03-pausa-sla-calendario, 5.2).
  slaBusinessHours             Boolean         @default(false)
  /// Start of the current SLA pause; null when not paused (5.3).
  slaPausedAt                  DateTime?       @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3 and 4.4: copy of the level sectors at the
  /// opening, the current level (from 1) and the sector that decides it while pending. Requests
  /// opened before levels keep the copy empty: one level, decided by the request's sector.
  approvalSectorIdsSnapshot    String[]        @default([]) @db.Uuid
  approvalLevel                Int?
  approvalPendingSectorId      String?         @db.Uuid
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3.6: days per level copied at the opening,
  /// due date of the pending level and when its delay was announced.
  approvalDeadlineDaysSnapshot Int?
  approvalDueAt                DateTime?       @db.Timestamptz
  approvalOverdueNotifiedAt    DateTime?       @db.Timestamptz

  requester             User                       @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee              User?                      @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  service               Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sector                Sector                     @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  approvalPendingSector Sector?                    @relation("RequestApprovalPendingSector", fields: [approvalPendingSectorId], references: [id], onDelete: Restrict)
  events                RequestStatusEvent[]
  attachments           RequestAttachment[]
  assignmentEvents      RequestAssignmentEvent[]
  priorityEvents        RequestPriorityEvent[]
  fieldValues           RequestFieldValue[]
  stageEvents           RequestStageEvent[]
  sectorEvents          RequestSectorEvent[]
  commentFiles          RequestCommentFile[]
  slaPauses             RequestSlaPause[]
  fieldUpdates          RequestFieldUpdateEvent[]
  satisfaction          RequestSatisfaction?
  escalations           RequestEscalation[]
  /// SPEC 2026-11-07-operacao-e-automacao, 3.3 item 1.
  linksFrom             RequestLink[]              @relation("RequestLinkFrom")
  linksTo               RequestLink[]              @relation("RequestLinkTo")
  linkEventsFrom        RequestLinkEvent[]         @relation("RequestLinkEventFrom")
  linkEventsTo          RequestLinkEvent[]         @relation("RequestLinkEventTo")
  /// SPEC 2026-11-07-operacao-e-automacao, 3.3 item 3: the bundle opening this request belongs to.
  groupId               String?                    @db.Uuid
  /// Position in the bundle's order (1 to 5), only with a group: the requests share the opening instant.
  groupPosition         Int?
  /// SPEC 2026-11-07-operacao-e-automacao, 5.3 item 3: opened by this schedule.
  recurringRequestId    String?                    @db.Uuid
  recurringRequest      RecurringRequest?          @relation(fields: [recurringRequestId], references: [id], onDelete: Restrict)
  recurringRuns         RecurringRequestRun[]
  group                 RequestGroup?              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  satisfactionEvents    RequestSatisfactionEvent[]
  approvals             RequestApproval[]
  comments              RequestComment[]
  outboxEvents          OutboxEvent[]
  notifications         RequestNotification[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 3.4.
  tags                  RequestTag[]
  tagEvents             RequestTagEvent[]
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 4.4.
  checklist             RequestChecklist?
  checklistItems        RequestChecklistItem[]
  checklistEvents       RequestChecklistEvent[]

  @@index([requesterId])
  @@index([sectorId])
  @@index([sectorId, assigneeId])
  @@index([requesterId, createdAt, id])
  @@index([sectorId, createdAt, id])
  @@index([sectorId, dueAt])
  @@index([sectorId, dueSoonAt])
  @@index([approvalPendingSectorId])
  @@index([approvalDueAt])
  @@index([stageDueAt])
  @@index([sectorId, currentStageName])
}

model RequestStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @db.Uuid
  actorId    String         @db.Uuid
  fromStatus RequestStatus?
  toStatus   RequestStatus
  occurredAt DateTime       @default(now()) @db.Timestamptz
  note       String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestStatusEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// History of one request and "last status before an instant" (SPEC 2026-11-06-desempenho-volume).
  @@index([requestId, occurredAt, id])
}

model RequestAssignmentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @db.Uuid
  /// Null when the system made the change: an escalation rule's handover (SPEC
  /// 2026-11-06-aprofundamento-configurabilidade, 7.3 item 3, decision G17).
  actorId        String?  @db.Uuid
  /// Why the system made the change (SPEC 2026-11-07-operacao-e-automacao, 4.4, decision H19); null for people.
  reason         AssignmentReason?
  fromAssigneeId String?  @db.Uuid
  toAssigneeId   String?  @db.Uuid
  occurredAt     DateTime @default(now()) @db.Timestamptz

  request      Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor        User?   @relation("RequestAssignmentEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromAssignee User?   @relation("RequestAssignmentEventFrom", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee   User?   @relation("RequestAssignmentEventTo", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

// Name uniqueness among active requirements of a service and row-level CHECK
// constraints are created in SQL by migration 20261016120000_document_requirements_and_attachments.
model ServiceDocumentRequirement {
  id              String           @id @default(uuid()) @db.Uuid
  serviceId       String           @db.Uuid
  name            String           @db.Citext
  isRequired      Boolean
  acceptedFormats DocumentFormat[]
  position        Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  attachments RequestAttachment[]

  @@index([serviceId])
}

// Attachments are immutable metadata; file content lives in private object storage.
model RequestAttachment {
  id                          String         @id @default(uuid()) @db.Uuid
  requestId                   String         @db.Uuid
  requirementId               String         @db.Uuid
  requirementNameSnapshot     String
  requirementRequiredSnapshot Boolean
  originalFilename            String
  detectedFormat              DocumentFormat
  contentType                 String
  sizeBytes                   Int
  sha256                      String         @db.Char(64)
  storageKey                  String
  uploadedById                String         @db.Uuid
  createdAt                   DateTime       @default(now()) @db.Timestamptz
  /// SPEC 2026-11-02-auditoria-lgpd, 5.5: the file was removed by an anonymization.
  removedAt                   DateTime?      @db.Timestamptz

  request     Request                    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requirement ServiceDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  uploadedBy  User                       @relation("RequestAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([requestId, requirementId])
  @@index([requirementId])
  @@index([uploadedById])
}

model RequestComment {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz

  request Request              @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User                 @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  files   RequestCommentFile[]

  /// Target of the composite key of RequestCommentFile: a file belongs to the comment's request.
  @@unique([id, requestId])
  @@index([requestId, createdAt])
}

/// File attached to a comment (SPEC 2026-11-03-anexos-comentarios-documentos, 5.1 and 6). Immutable
/// metadata; the content lives in private object storage. Row CHECKs are created in SQL.
model RequestCommentFile {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @db.Uuid
  commentId        String         @db.Uuid
  originalFilename String
  detectedFormat   DocumentFormat
  contentType      String
  sizeBytes        Int
  sha256           String         @db.Char(64)
  storageKey       String         @unique
  uploadedById     String         @db.Uuid
  createdAt        DateTime       @db.Timestamptz
  /// SPEC 2026-11-02-auditoria-lgpd, 5.5: the file was removed by an anonymization.
  removedAt        DateTime?      @db.Timestamptz

  request    Request        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  comment    RequestComment @relation(fields: [commentId, requestId], references: [id, requestId], onDelete: Restrict)
  uploadedBy User           @relation("RequestCommentFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([commentId])
  @@index([requestId])
  @@index([uploadedById])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  requestId     String    @db.Uuid
  payload       Json
  occurredAt    DateTime  @db.Timestamptz
  availableAt   DateTime  @db.Timestamptz
  attempts      Int       @default(0)
  processedAt   DateTime? @db.Timestamptz
  failedAt      DateTime? @db.Timestamptz
  lastErrorCode String?

  request       Request               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  notifications RequestNotification[]

  @@index([processedAt, failedAt, availableAt])
}

model RequestNotification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  requestId   String    @db.Uuid
  eventId     String?   @db.Uuid
  type        String
  createdAt   DateTime  @db.Timestamptz
  readAt      DateTime? @db.Timestamptz

  recipient User           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event     OutboxEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  email     EmailDelivery?

  @@unique([eventId, recipientId])
  @@index([recipientId, readAt, createdAt])
}

/// Email choice per user and category (SPEC 2026-11-01-notificacoes-email-preferencias, 5.1).
/// Without a row, the category is off.
model NotificationPreference {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  category     NotificationCategory
  emailEnabled Boolean
  updatedAt    DateTime             @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, category])
}

/// Email to send for one in-app notification (SPEC 2026-11-01-notificacoes-email-preferencias, 5.2).
/// Goes away with its notification when the daily cleanup purges it.
model EmailDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @unique @db.Uuid
  recipientId    String              @db.Uuid
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  availableAt    DateTime            @db.Timestamptz
  createdAt      DateTime            @db.Timestamptz
  sentAt         DateTime?           @db.Timestamptz
  lastErrorCode  String?

  notification RequestNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient    User                @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([createdAt])
}

model RequestPriorityEvent {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @db.Uuid
  actorId      String          @db.Uuid
  fromPriority RequestPriority
  toPriority   RequestPriority
  occurredAt   DateTime        @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestPriorityEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// Custom field of a service (SPEC 2026-11-01-campos-personalizados, section 6).
model ServiceField {
  id               String               @id @default(uuid()) @db.Uuid
  serviceId        String               @db.Uuid
  label            String               @db.Citext
  helpText         String?
  type             ServiceFieldType
  isRequired       Boolean
  options          String[]
  minValue         Int?
  maxValue         Int?
  /// Decimal fields only (SPEC 2026-11-06-aprofundamento-configurabilidade, 3.3.1 and 3.4).
  decimalPlaces    Int?
  minDecimal       Decimal?             @db.Decimal(14, 4)
  maxDecimal       Decimal?             @db.Decimal(14, 4)
  position         Int
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now()) @db.Timestamptz
  updatedAt        DateTime             @updatedAt @db.Timestamptz
  /// SPEC 2026-11-03-campos-condicionais-atendimento, 5.2 and 5.4. The controller belongs to the
  /// same service (composite key in SQL).
  audience         ServiceFieldAudience @default(REQUESTER)
  conditionFieldId String?              @db.Uuid
  conditionValue   String?

  service             Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  values              RequestFieldValue[]
  conditionField      ServiceField?       @relation("ServiceFieldCondition", fields: [conditionFieldId], references: [id], onDelete: Restrict)
  dependents          ServiceField[]      @relation("ServiceFieldCondition")
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3.7.
  approvalConditionOf Service[]           @relation("ServiceApprovalCondition")
  /// 5.3.3.
  stageConditionOf    ServiceStage[]      @relation("ServiceStageCondition")

  @@unique([id, serviceId])
  @@index([serviceId])
  @@index([conditionFieldId])
  /// SPEC 2026-11-08-atendimento-dia-a-dia, 13.1 item 1: checklist items conditioned on this field.
  checklistConditions ServiceChecklistItem[]
}

/// Answer given on opening, with a snapshot of the field definition; immutable.
model RequestFieldValue {
  id               String           @id @default(uuid()) @db.Uuid
  requestId        String           @db.Uuid
  fieldId          String           @db.Uuid
  labelSnapshot    String
  typeSnapshot     ServiceFieldType
  positionSnapshot Int
  value            String
  createdAt        DateTime         @default(now()) @db.Timestamptz

  /// Set by the attendance's saves (SPEC 2026-11-03-campos-condicionais-atendimento, 5.5.5).
  updatedAt   DateTime? @db.Timestamptz
  updatedById String?   @db.Uuid

  request   Request      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  field     ServiceField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  updatedBy User?        @relation("RequestFieldValueUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([requestId, fieldId])
  @@index([fieldId])
}

/// A save of the attendance's fields (SPEC 2026-11-03-campos-condicionais-atendimento, 5.5.3): the
/// labels that changed, never the values.
model RequestFieldUpdateEvent {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  actorId    String   @db.Uuid
  labels     String[]
  occurredAt DateTime @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestFieldUpdateEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// Stage of a service's attendance flow (SPEC 2026-11-01-fluxos-configuraveis, section 6).
model ServiceStage {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @db.Uuid
  name             String   @db.Citext
  position         Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 5.3 and 5.4: the attendant who receives the
  /// request on entering the stage, the target in days and the condition on a requester answer.
  assigneeId       String?  @db.Uuid
  targetDays       Int?
  conditionFieldId String?  @db.Uuid
  conditionValue   String?

  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignee       User?         @relation("ServiceStageAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  conditionField ServiceField? @relation("ServiceStageCondition", fields: [conditionFieldId], references: [id], onDelete: Restrict)

  @@index([serviceId])
}

/// Entry into a stage of the request's flow copy; fromStage is null on the first stage.
model RequestStageEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  requestId           String   @db.Uuid
  actorId             String   @db.Uuid
  fromStage           String?
  toStage             String
  note                String?
  occurredAt          DateTime @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 5.3.1: the stage's attendant was not an active
  /// attendant of the request's sector on entering, so the assignee did not change.
  assigneeUnavailable Boolean  @default(false)

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestStageEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// A request sent to another sector (SPEC 2026-11-03-transferencia-entre-setores, 5.3 and 6). The
/// names are the ones at the time; the note is mandatory and checked in SQL.
model RequestSectorEvent {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @db.Uuid
  actorId        String   @db.Uuid
  fromSectorId   String   @db.Uuid
  toSectorId     String   @db.Uuid
  fromSectorName String
  toSectorName   String
  note           String
  occurredAt     DateTime @db.Timestamptz

  request    Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      User    @relation("RequestSectorEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromSector Sector  @relation("RequestSectorEventFrom", fields: [fromSectorId], references: [id], onDelete: Restrict)
  toSector   Sector  @relation("RequestSectorEventTo", fields: [toSectorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// An SLA pause "aguardando o solicitante" (SPEC 2026-11-03-pausa-sla-calendario, 5.3 and 6). The
/// resume columns are filled together; one open pause per request (partial unique index in SQL).
model RequestSlaPause {
  id          String          @id @default(uuid()) @db.Uuid
  requestId   String          @db.Uuid
  pausedById  String          @db.Uuid
  reason      String
  pausedAt    DateTime        @db.Timestamptz
  resumedAt   DateTime?       @db.Timestamptz
  resumedById String?         @db.Uuid
  resumeCause SlaResumeCause?

  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  pausedBy  User    @relation("RequestSlaPauseActor", fields: [pausedById], references: [id], onDelete: Restrict)
  resumedBy User?   @relation("RequestSlaResumeActor", fields: [resumedById], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// The requester's rating of a completed request (SPEC 2026-11-06-pesquisa-satisfacao, 4 and 5).
/// One row per request; a new completion lets the requester rate again, replacing this row. The
/// rating range and the comment length are checked in SQL.
model RequestSatisfaction {
  id                  String   @id @default(uuid()) @db.Uuid
  requestId           String   @unique @db.Uuid
  requesterId         String   @db.Uuid
  rating              Int      @db.SmallInt
  comment             String?
  completedAtSnapshot DateTime @db.Timestamptz
  ratedAt             DateTime @db.Timestamptz

  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requester User    @relation("RequestSatisfactionRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  @@index([ratedAt])
}

/// History of the ratings (SPEC 2026-11-06-pesquisa-satisfacao, 4.5): never the comment.
model RequestSatisfactionEvent {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  actorId    String   @db.Uuid
  rating     Int      @db.SmallInt
  replaced   Boolean
  occurredAt DateTime @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation("RequestSatisfactionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// A canned response of a sector (SPEC 2026-11-06-respostas-prontas, 4 and 5). Title and body
/// limits and the title unique among the active responses of a sector are checked in SQL.
model CannedResponse {
  id          String   @id @default(uuid()) @db.Uuid
  sectorId    String   @db.Uuid
  title       String   @db.Citext
  body        String
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid
  createdAt   DateTime @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz

  sector    Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  createdBy User   @relation("CannedResponseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User   @relation("CannedResponseUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([sectorId])
}

/// An automatic escalation of an overdue request (SPEC 2026-11-06-escalonamento, 4 and 5): written
/// by the daily job with the SLA breach alert; the priorities before and after may be equal
/// (already urgent).
model RequestEscalation {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @db.Uuid
  fromPriority RequestPriority
  toPriority   RequestPriority
  occurredAt   DateTime        @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 7.4: the existing rows came from the option.
  trigger           EscalationTrigger @default(OVERDUE)
  /// The N of "vencida há N dias", copied from the rule.
  overdueDays       Int?
  /// The rule applied; null for the option or after the rule was deleted (7.3 item 6).
  ruleId            String?           @db.Uuid
  /// The rule's name when applied, so the detail keeps it after edits and deletion.
  ruleName          String?
  /// The request's due date when applied: a rule applies once per request and due date (7.3 item 2).
  dueAt             DateTime?         @db.Timestamptz
  /// Whom the rule handed the request to, or null.
  assignedToId      String?           @db.Uuid
  /// The rule had an attendant who was not available, so the handover was skipped (7.3 item 3).
  assignmentSkipped Boolean           @default(false)
  /// Whom the rule warned (7.3 item 4); the notification consumer reads them from here.
  notifiedUserIds   String[]          @default([]) @db.Uuid

  request    Request               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  rule       SectorEscalationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  assignedTo User?                 @relation("RequestEscalationAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([occurredAt])
}

/// A bundle of services opened together (SPEC 2026-11-07-operacao-e-automacao, 3.3 item 2, decision H3).
/// The services, in order, are checked in SQL (2 to 5, none repeated); deactivated, never deleted.
model ServiceBundle {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.Citext
  description String?
  serviceIds  String[] @default([]) @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  groups RequestGroup[]
}

/// The requests one bundle opening created (3.3 items 3 and 4), with the bundle's name then.
model RequestGroup {
  id                 String   @id @default(uuid()) @db.Uuid
  bundleId           String?  @db.Uuid
  bundleNameSnapshot String
  requesterId        String   @db.Uuid
  createdAt          DateTime @db.Timestamptz

  bundle    ServiceBundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  requester User           @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  requests  Request[]

  @@index([requesterId, createdAt])
}

/// Kind of link between two requests (SPEC 2026-11-07-operacao-e-automacao, 3.3 item 1).
enum RequestLinkKind {
  /// Symmetric: shown on both requests.
  RELATED
  /// The "from" request duplicates the "to" request (the original).
  DUPLICATE_OF
}

enum RequestLinkAction {
  LINKED
  UNLINKED
}

/// A link between two requests (3.3 item 1). One per pair, whatever the kind; the shape and the
/// "one duplicate per request" rule are checked in SQL.
model RequestLink {
  id            String          @id @default(uuid()) @db.Uuid
  fromRequestId String          @db.Uuid
  toRequestId   String          @db.Uuid
  kind          RequestLinkKind
  createdById   String          @db.Uuid
  createdAt     DateTime        @db.Timestamptz

  fromRequest Request @relation("RequestLinkFrom", fields: [fromRequestId], references: [id], onDelete: Restrict)
  toRequest   Request @relation("RequestLinkTo", fields: [toRequestId], references: [id], onDelete: Restrict)
  createdBy   User    @relation("RequestLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([fromRequestId])
  @@index([toRequestId])
}

/// History of the links (3.3 item 1): shown on both requests.
model RequestLinkEvent {
  id            String            @id @default(uuid()) @db.Uuid
  fromRequestId String            @db.Uuid
  toRequestId   String            @db.Uuid
  kind          RequestLinkKind
  action        RequestLinkAction
  actorId       String            @db.Uuid
  occurredAt    DateTime          @db.Timestamptz

  fromRequest Request @relation("RequestLinkEventFrom", fields: [fromRequestId], references: [id], onDelete: Restrict)
  toRequest   Request @relation("RequestLinkEventTo", fields: [toRequestId], references: [id], onDelete: Restrict)
  actor       User    @relation("RequestLinkEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([fromRequestId, occurredAt])
  @@index([toRequestId, occurredAt])
}

/// An escalation rule of a sector (SPEC 2026-11-06-aprofundamento-configurabilidade, 7.1 to 7.4),
/// besides the "Escalar solicitações vencidas" option. The shape is checked in SQL.
model SectorEscalationRule {
  id             String            @id @default(uuid()) @db.Uuid
  sectorId       String            @db.Uuid
  name           String            @db.Citext
  /// DUE_SOON or OVERDUE_DAYS; OVERDUE belongs to the option only.
  trigger        EscalationTrigger
  /// 1 to 30, only with OVERDUE_DAYS.
  overdueDays    Int?
  raisePriority  Boolean           @default(false)
  assignToId     String?           @db.Uuid
  notifyManagers Boolean           @default(false)
  notifyTeam     Boolean           @default(false)
  notifyUserIds  String[]          @default([]) @db.Uuid
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  sector      Sector              @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  assignTo    User?               @relation("SectorEscalationRuleAssignee", fields: [assignToId], references: [id], onDelete: Restrict)
  escalations RequestEscalation[]

  @@index([sectorId])
}

/// A knowledge base article of a service (SPEC 2026-11-06-base-conhecimento, 4 and 5). Limits and
/// the title unique within a service are checked in SQL; a new article is a draft.
model KnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  serviceId   String   @db.Uuid
  title       String   @db.Citext
  body        String
  isPublished Boolean  @default(false)
  position    Int      @default(999)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid
  createdAt   DateTime @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy User    @relation("KnowledgeArticleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User    @relation("KnowledgeArticleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([serviceId, title])
}

/// How often a schedule opens a request (SPEC 2026-11-07-operacao-e-automacao, 5.3, decision H9).
enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum RecurringRunOutcome {
  OPENED
  SKIPPED
}

/// Why a run did not open the request (5.3 item 3).
enum RecurringSkipReason {
  SERVICE_UNAVAILABLE
  REQUESTER_INACTIVE
  FORM_CHANGED
  DOCUMENT_REQUIRED
}

/// A schedule that opens a request periodically in a requester's name (5.3). The shape is checked in SQL.
model RecurringRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  serviceId           String              @db.Uuid
  requesterId         String              @db.Uuid
  createdById         String              @db.Uuid
  description         String
  /// The answers to the service's fields, by field id, as the opening form sends them.
  answers             Json                @default("{}")
  frequency           RecurrenceFrequency
  /// ISO weekdays (1 = Monday to 7 = Sunday), only with WEEKLY.
  weekdays            Int[]               @default([])
  /// 1 to 28, only with MONTHLY.
  monthDay            Int?
  startsOn            DateTime            @db.Date
  endsOn              DateTime?           @db.Date
  pausedAt            DateTime?           @db.Timestamptz
  endedAt             DateTime?           @db.Timestamptz
  /// Runs in a row that did not open; three pause the schedule (5.3 item 3).
  consecutiveFailures Int                 @default(0)
  createdAt           DateTime            @default(now()) @db.Timestamptz
  updatedAt           DateTime            @updatedAt @db.Timestamptz

  service   Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  requester User                  @relation("RecurringRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  createdBy User                  @relation("RecurringRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  runs      RecurringRequestRun[]
  requests  Request[]

  @@index([serviceId])
}

/// One run of a schedule, on a day (5.3 item 3): once per schedule and day.
model RecurringRequestRun {
  id                 String               @id @default(uuid()) @db.Uuid
  recurringRequestId String               @db.Uuid
  scheduledOn        DateTime             @db.Date
  outcome            RecurringRunOutcome
  reason             RecurringSkipReason?
  requestId          String?              @db.Uuid
  occurredAt         DateTime             @db.Timestamptz

  recurringRequest RecurringRequest @relation(fields: [recurringRequestId], references: [id], onDelete: Restrict)
  request          Request?         @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([recurringRequestId, scheduledOn])
}

/// How a sector assigns the requests entering its queue (SPEC 2026-11-07-operacao-e-automacao, 4.3).
enum DistributionMode {
  NONE
  ROUND_ROBIN
  LEAST_LOAD
}

/// Why the system changed an assignment (4.4, decision H19).
enum AssignmentReason {
  DISTRIBUTION
  ABSENCE
  ESCALATION_RULE
}

/// An attendant's absence (4.3 item 7): out of the distribution on these days, both included.
model AttendantAbsence {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  startsOn        DateTime  @db.Date
  endsOn          DateTime  @db.Date
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz
  cancelledAt     DateTime? @db.Timestamptz
  /// When the job handed the attendant's requests to colleagues (once per absence).
  redistributedAt DateTime? @db.Timestamptz

  user      User @relation("AttendantAbsenceUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("AttendantAbsenceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, startsOn])
}

/// What escalated a request (SPEC 2026-11-06-aprofundamento-configurabilidade, 7.4): the sector's
/// "Escalar solicitações vencidas" option (OVERDUE) or a rule of the sector.
enum EscalationTrigger {
  OVERDUE
  DUE_SOON
  OVERDUE_DAYS
}

enum SlaResumeCause {
  MANUAL
  REQUESTER_REPLY
  ATTENDANCE_ENDED
}

/// The organization's business calendar, a single row (SPEC 2026-11-03-pausa-sla-calendario, 5.1).
/// Weekdays are ISO (1 = Monday to 7 = Sunday); the window is in minutes of the day.
model BusinessCalendar {
  id          Int      @id @default(1)
  weekdays    Int[]
  startMinute Int
  endMinute   Int
  timeZone    String
  updatedAt   DateTime @default(now()) @db.Timestamptz
  updatedById String?  @db.Uuid

  updatedBy User? @relation("BusinessCalendarUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
}

/// A day without business hours (5.1); `yearly` repeats it on the same day and month.
model BusinessHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  day         DateTime @unique @db.Date
  name        String
  yearly      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  createdById String   @db.Uuid

  createdBy User @relation("BusinessHolidayCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

/// Decision of a manager on a request that required approval (SPEC 2026-11-01-aprovacoes, 5.6).
model RequestApproval {
  id           String           @id @default(uuid()) @db.Uuid
  requestId    String           @db.Uuid
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.4: one decision per level; 1 before levels.
  level        Int              @default(1)
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3.5: the absent manager the decider replaced.
  onBehalfOfId String?          @db.Uuid
  /// 4.3.6: due date the level had when it was decided, for "Análises".
  dueAt        DateTime?        @db.Timestamptz
  deciderId    String           @db.Uuid
  decision     ApprovalDecision
  note         String?
  decidedAt    DateTime         @db.Timestamptz

  request    Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  decider    User    @relation("RequestApprovalDecider", fields: [deciderId], references: [id], onDelete: Restrict)
  onBehalfOf User?   @relation("RequestApprovalOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: Restrict)

  @@unique([requestId, level])
  @@index([deciderId])
}

/// A manager's absence with a substitute (SPEC 2026-11-06-aprofundamento-configurabilidade, 4.3.5 and
/// 4.4). Days are calendar days of the organization, both inclusive; cancelling keeps the row.
model ManagerAbsence {
  id           String    @id @default(uuid()) @db.Uuid
  managerId    String    @db.Uuid
  substituteId String    @db.Uuid
  startsOn     DateTime  @db.Date
  endsOn       DateTime  @db.Date
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz
  cancelledAt  DateTime? @db.Timestamptz

  manager    User @relation("ManagerAbsenceManager", fields: [managerId], references: [id], onDelete: Restrict)
  substitute User @relation("ManagerAbsenceSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)
  createdBy  User @relation("ManagerAbsenceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([managerId, endsOn])
  @@index([substituteId, endsOn])
}

/// Additional permission granted to a user (SPEC 2026-11-01-permissoes-configuraveis, section 6).
model UserPermission {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  permission  Permission
  grantedById String     @db.Uuid
  grantedAt   DateTime   @db.Timestamptz
  /// SPEC 2026-11-06-aprofundamento-configurabilidade, 6.3.2: last day it counts (organization's
  /// calendar day), or null without an end.
  expiresOn   DateTime?  @db.Date

  user      User @relation("UserPermissionHolder", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, permission])
}

/// Grant or revocation of a permission (SPEC 2026-11-01-permissoes-configuraveis, 5.4).
model UserPermissionEvent {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  permission Permission
  action     PermissionAction
  actorId    String           @db.Uuid
  occurredAt DateTime         @db.Timestamptz
  /// 6.3.2: the end given with the grant.
  expiresOn  DateTime?        @db.Date

  user  User @relation("UserPermissionEventUser", fields: [userId], references: [id], onDelete: Restrict)
  actor User @relation("UserPermissionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

/// A set of the existing permissions created by the administrator (SPEC
/// 2026-11-06-aprofundamento-configurabilidade, 6.3.1 and 6.4). Deactivated, never deleted.
model AccessRole {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.Citext
  description String?
  permissions Permission[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  assignments UserAccessRole[]
  events      UserAccessRoleEvent[]
}

/// A role given to a user, optionally until a day (6.3.1 and 6.3.2).
model UserAccessRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  assignedById String    @db.Uuid
  assignedAt   DateTime  @db.Timestamptz
  expiresOn    DateTime? @db.Date

  user       User       @relation("UserAccessRoleHolder", fields: [userId], references: [id], onDelete: Restrict)
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User       @relation("UserAccessRoleAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Assignment or removal of a role (6.3.3), with the end given.
model UserAccessRoleEvent {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  roleId     String           @db.Uuid
  action     PermissionAction
  actorId    String           @db.Uuid
  occurredAt DateTime         @db.Timestamptz
  expiresOn  DateTime?        @db.Date

  user  User       @relation("UserAccessRoleEventUser", fields: [userId], references: [id], onDelete: Restrict)
  role  AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  actor User       @relation("UserAccessRoleEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

/// One administrative change (SPEC 2026-11-02-auditoria-lgpd, 5.1 and 6), written in the same
/// transaction as the change. `changes` holds the changed fields; personal fields only say that
/// they changed, and secrets never appear. `actorId` is the session's user id, kept as text
/// without a foreign key (SF-103): people are never deleted, only anonymized.
model AuditEntry {
  id          String          @id @default(uuid()) @db.Uuid
  occurredAt  DateTime        @default(now()) @db.Timestamptz
  actorId     String
  actorRole   Role
  action      AuditAction
  entityType  AuditEntityType
  entityId    String          @db.Uuid
  entityLabel String
  changes     Json            @default("[]")

  @@index([occurredAt, id])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
}

/// Personal API token (SPEC 2026-11-02-api-externa-webhooks, 5.1 and 6). Only the SHA-256 of the
/// value is kept; the value is shown once. Revoked or expired tokens never authenticate.
model ApiToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  name        String
  scope       ApiTokenScope
  tokenHash   String        @unique
  lastFour    String
  createdAt   DateTime      @default(now()) @db.Timestamptz
  expiresAt   DateTime      @db.Timestamptz
  lastUsedAt  DateTime?     @db.Timestamptz
  revokedAt   DateTime?     @db.Timestamptz
  revokedById String?       @db.Uuid

  user        User            @relation("ApiTokenOwner", fields: [userId], references: [id], onDelete: Restrict)
  revokedBy   User?           @relation("ApiTokenRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  rateWindows ApiRateWindow[]

  @@index([userId, createdAt])
}

/// Calls of one token in one minute (SPEC 2026-11-02-api-externa-webhooks, 5.5, decision A6).
model ApiRateWindow {
  tokenId     String   @db.Uuid
  windowStart DateTime @db.Timestamptz
  count       Int

  token ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, windowStart])
  @@index([windowStart])
}

/// Outgoing webhook (SPEC 2026-11-02-api-externa-webhooks, 5.6, decision A5). The signing secret
/// is stored encrypted with a key that lives only in an environment variable.
model WebhookEndpoint {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  url             String
  eventTypes      String[]
  /// SPEC 2026-11-03-api-acoes-webhooks-setor, 5.2: empty means every sector.
  sectorIds       String[] @default([]) @db.Uuid
  isActive        Boolean  @default(true)
  encryptedSecret String
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  deliveries WebhookDelivery[]
}

/// One delivery of one event to one webhook; the body is copied because outbox events are purged.
model WebhookDelivery {
  id            String                @id @default(uuid()) @db.Uuid
  endpointId    String                @db.Uuid
  eventId       String                @db.Uuid
  eventType     String
  body          Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  availableAt   DateTime              @db.Timestamptz
  createdAt     DateTime              @db.Timestamptz
  deliveredAt   DateTime?             @db.Timestamptz
  lastErrorCode String?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@unique([eventId, endpointId])
  @@index([status, availableAt])
  @@index([createdAt])
}

/// The lists with saved views (SPEC 2026-11-07-operacao-e-automacao, 7.3 item 1).
enum SavedViewList {
  QUEUE
  MY_REQUESTS
}

/// A person's saved search of a list (7.3 item 1, decision H16): only the person sees it. The criteria are
/// the list's normalized query string, as in the URL.
model SavedView {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  list      SavedViewList
  name      String        @db.Citext
  criteria  String
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, list, name])
}

/// A sector's tag (SPEC 2026-11-08-atendimento-dia-a-dia, 3.3 item 1; decisions I1 and I3): a name unique
/// among the sector's active tags and a color of a fixed palette.
model SectorTag {
  id        String   @id @default(uuid()) @db.Uuid
  sectorId  String   @db.Uuid
  name      String   @db.Citext
  color     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  sector   Sector            @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  requests RequestTag[]
  events   RequestTagEvent[]

  @@index([sectorId])
}

/// A tag on a request (3.3 item 2): only the team sees it.
model RequestTag {
  requestId String   @db.Uuid
  tagId     String   @db.Uuid
  addedById String   @db.Uuid
  addedAt   DateTime @db.Timestamptz

  request Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tag     SectorTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  addedBy User      @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@id([requestId, tagId])
  @@index([tagId])
}

enum RequestTagAction {
  ADDED
  REMOVED
}

/// The history of a request's tags (3.3 item 3).
model RequestTagEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  tagId      String           @db.Uuid
  action     RequestTagAction
  actorId    String           @db.Uuid
  occurredAt DateTime         @db.Timestamptz

  request Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tag     SectorTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  actor   User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
}

/// An item of a service's checklist model (SPEC 2026-11-08-atendimento-dia-a-dia, 4.3 item 1 and 13.1 item 1):
/// text, required or optional, order, and an optional condition on an answer, as the stages' conditions.
model ServiceChecklistItem {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @db.Uuid
  text             String
  isRequired       Boolean
  position         Int
  isActive         Boolean  @default(true)
  conditionFieldId String?  @db.Uuid
  conditionValue   String?
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  conditionField ServiceField? @relation(fields: [conditionFieldId], references: [id], onDelete: Restrict)
  copies         RequestChecklistItem[]

  @@index([serviceId])
}

/// Marks that a request's checklist was copied (4.3 item 2): once, even when the model had no item.
model RequestChecklist {
  requestId String   @id @db.Uuid
  copiedAt  DateTime @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
}

/// An item of a request's checklist (4.3 items 2 and 3; 13.1 item 4): a copy of the model's item when the
/// request entered the attendance, marked or not, with an optional note.
model RequestChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String    @db.Uuid
  templateItemId String?   @db.Uuid
  textSnapshot   String
  isRequired     Boolean
  position       Int
  doneAt         DateTime? @db.Timestamptz
  doneById       String?   @db.Uuid
  note           String?

  request      Request               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  templateItem ServiceChecklistItem? @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  doneBy       User?                 @relation(fields: [doneById], references: [id], onDelete: Restrict)
  events       RequestChecklistEvent[]

  @@unique([requestId, position])
}

enum RequestChecklistAction {
  DONE
  UNDONE
}

/// The history of a request's checklist (4.3 item 3).
model RequestChecklistEvent {
  id         String                 @id @default(uuid()) @db.Uuid
  requestId  String                 @db.Uuid
  itemId     String                 @db.Uuid
  action     RequestChecklistAction
  note       String?
  actorId    String                 @db.Uuid
  occurredAt DateTime               @db.Timestamptz

  request Request              @relation(fields: [requestId], references: [id], onDelete: Restrict)
  item    RequestChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor   User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
}
