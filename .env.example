# Copy this file to .env.local or .env before running the application.
# Keep real values outside the repository.
NODE_ENV=development
AUTH_SECRET=
# Auth.js trusts the request host automatically in development and on Vercel.
# Uncomment only to serve a local production build with `npm run start`.
# Keep it commented otherwise: an empty value disables the automatic trust.
# AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://serviceflow:change-me@localhost:5432/serviceflow_dev
# Private document storage (SPEC 21.15.7). Server-side only; never use a NEXT_PUBLIC_ prefix.
# Configure all three together, with a dedicated sb_secret_ key. Not provisioned yet (SF-030).
# DOCUMENT_STORAGE_URL=
# DOCUMENT_STORAGE_BUCKET=serviceflow-documents-dev
# DOCUMENT_STORAGE_SECRET_KEY=
# Notification emails (SPEC 2026-11-01-notificacoes-email-preferencias, 5.3). Server-side only.
# Configure all three together; without them, nothing is sent and deliveries are recorded as
# not sent. EMAIL_API_KEY is the provider (Resend) API key: set it only in the environment.
# EMAIL_API_KEY=
# EMAIL_FROM=ServiceFlow <avisos@seu-dominio.example>
# APP_BASE_URL=https://seu-app.example

# Webhooks (SPEC 2026-11-02-api-externa-webhooks, 5.6). Server-side only. 32 random bytes in base64,
# for example from `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# It encrypts the signing secrets: changing it makes the existing secrets unreadable (generate new
# ones). Without it, webhooks are not configured and nothing is registered or sent.
# WEBHOOK_ENCRYPTION_KEY=
# Tests only: accepts http://localhost receivers. Never set it in a published environment.
# WEBHOOK_ALLOW_LOCAL=
