# Use a dedicated PostgreSQL database whose name ends in _test.
# Never point this URL at the development or production database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/serviceflow_test?schema=public
# Optional: real document storage tests. Without these, tests use the in-memory adapter.
# The bucket name must end in -test; there is no fallback to DOCUMENT_STORAGE_* values.
# TEST_DOCUMENT_STORAGE_URL=
# TEST_DOCUMENT_STORAGE_BUCKET=serviceflow-documents-test
# TEST_DOCUMENT_STORAGE_SECRET_KEY=
